{
	"compilerOptions": {
		"sourceMap": true,
		"module": "commonjs",
		"moduleResolution": "bundler",
		"target": "ES6",
		"outDir": "./lib",
		"lib": [
			"dom",
			"es2021"
		],
		"types": [],
		"noImplicitAny": false,
		"strictNullChecks": false,
		"skipLibCheck": true,
		"typeRoots": [
			"node_modules/@types"
		]
	},
	"include": [
		"./src/**/*"
	],
	"exclude": [
		"node_modules"
	]
}